diff --git a/assets/css/operation-dnd.css b/assets/css/operation-dnd.css
new file mode 100644
index 0000000..827ceeb
--- /dev/null
+++ b/assets/css/operation-dnd.css
@@ -0,0 +1,225 @@
+/* Учебная операция: drag & drop инструментов. Подключается после operation-pixel.css. */
+
+.op-board--dnd {
+  grid-template-columns: minmax(300px, .85fr) 1.15fr;
+  min-height: 560px;
+}
+.op-board--dnd .op-patient { display: flex; flex-direction: column; gap: 10px; padding: 18px; }
+.op-board--dnd .op-work { padding: clamp(18px, 3vw, 32px); }
+.op-board--dnd .op-work h2 { margin: 14px 0 6px; font-size: clamp(24px, 3.2vw, 34px); }
+.op-board--dnd .op-feedback {
+  min-height: 46px;
+  margin: 12px 0 14px !important;
+  padding: 10px 12px !important;
+  border: 2px solid #142a2b;
+  background: #081215;
+  box-shadow: 2px 2px 0 #000;
+  line-height: 1.45;
+}
+.op-feedback.is-info { color: #afc2b9 !important; }
+.op-feedback.is-good { border-color: #3b8a6b !important; background: #0d2620 !important; }
+.op-feedback.is-bad  { border-color: #a4473d !important; background: #2a1414 !important; }
+.op-feedback.is-warn { border-color: #b07a3a !important; background: #2a1f10 !important; color: #f3c487 !important; }
+
+/* ---------- Пациент / зона сброса ---------- */
+.op-dropzone {
+  position: relative;
+  border: 3px solid #23473f;
+  background: #0e1d21;
+  box-shadow: 3px 3px 0 #000;
+  transition: border-color .15s, box-shadow .15s;
+  user-select: none;
+}
+.op-dropzone__scene { display: block; line-height: 0; }
+.patient-svg { display: block; width: 100%; height: auto; max-height: 380px; image-rendering: pixelated; }
+.op-dropzone__hint {
+  position: absolute;
+  left: 8px; right: 8px; bottom: 8px;
+  padding: 5px 8px;
+  border: 2px solid #050b0d;
+  background: rgba(5, 11, 13, .82);
+  color: #afc2b9;
+  font-size: 12px;
+  text-align: center;
+  pointer-events: none;
+}
+.patient-target { animation: op-target 1.2s steps(2) infinite; }
+@keyframes op-target { 50% { opacity: .25; } }
+.patient-layer { opacity: 0; transition: opacity .4s; }
+.patient-layer.is-on { opacity: 1; }
+
+body.is-dragging-tool .op-dropzone { border-color: #f0a95c; box-shadow: 3px 3px 0 #000, 0 0 0 3px rgba(240, 169, 92, .25); }
+body.is-dragging-tool .op-dropzone__hint { color: #f0a95c; }
+.op-dropzone.is-over { border-color: #7fd6b0 !important; box-shadow: 3px 3px 0 #000, 0 0 0 4px rgba(127, 214, 176, .45) !important; }
+.op-dropzone.is-over .op-dropzone__hint { color: #7fd6b0; }
+.op-dropzone.is-accepted { border-color: #7fd6b0; box-shadow: 3px 3px 0 #000, 0 0 22px rgba(127, 214, 176, .55); }
+.op-dropzone.is-rejected { border-color: #e2685a !important; animation: op-shake .35s steps(4); }
+.op-dropzone.is-complete { border-color: #7fd6b0; }
+.op-dropzone.is-complete .patient-target,
+.op-dropzone.is-stopped .patient-target { display: none; }
+.op-dropzone.is-stopped { border-color: #a4473d; }
+
+/* ---------- Монитор показателей ---------- */
+.op-vitals {
+  display: flex; align-items: center; gap: 8px;
+  padding: 6px 10px;
+  border: 2px solid #142a2b;
+  background: #050d0f;
+  box-shadow: 2px 2px 0 #000;
+  color: #7fd6b0;
+  font-size: 13px;
+}
+.op-vitals b { font-size: 16px; color: #d6efe4; }
+.op-vitals small { color: #60746d; font-size: 11px; }
+.op-vitals__heart { color: #e2685a; animation: op-beat 1s steps(2) infinite; }
+.op-vitals__ecg { flex: 1; height: 22px; min-width: 40px; }
+.op-vitals__ecg polyline { fill: none; stroke: #7fd6b0; stroke-width: 2; stroke-dasharray: 260; stroke-dashoffset: 260; animation: op-ecg 1.6s linear infinite; }
+.op-vitals.is-alert { border-color: #b07a3a; color: #f0a95c; }
+.op-vitals.is-alert b { color: #f0a95c; }
+.op-vitals.is-alert polyline { stroke: #f0a95c; animation-duration: .8s; }
+.op-vitals.is-alert .op-vitals__heart { animation-duration: .45s; }
+@keyframes op-beat { 50% { opacity: .35; } }
+@keyframes op-ecg { to { stroke-dashoffset: 0; } }
+
+/* ---------- Порядок действий ---------- */
+.op-board--dnd .op-checklist { margin-top: 0; gap: 5px; }
+.op-seq__title { color: #60746d; font-size: 11px; text-transform: uppercase; letter-spacing: .1em; }
+.op-board--dnd .op-check { gap: 8px; min-height: 30px; }
+.op-board--dnd .op-check > span { flex: 1; display: flex; flex-direction: column; line-height: 1.25; }
+.op-board--dnd .op-check small { color: #60746d; font-size: 11px; }
+.op-check__tool {
+  display: grid; place-items: center;
+  width: 44px; height: 28px;
+  border: 2px solid #142a2b;
+  background: #081215;
+  font-style: normal; color: #3a5550; font-size: 12px;
+}
+.op-check__tool .tool-svg { width: 38px; height: 24px; }
+.op-check.is-done .op-check__tool { border-color: #3b8a6b; }
+
+/* ---------- Инструментальный стол ---------- */
+.op-table {
+  margin-top: auto;
+  padding: 12px;
+  border: 3px solid #050b0d;
+  background:
+    repeating-linear-gradient(90deg, rgba(255,255,255,.03) 0 2px, transparent 2px 8px),
+    linear-gradient(180deg, #2e6f86, #255d71);
+  box-shadow: inset 0 0 0 3px #3f88a1, 4px 4px 0 #000;
+}
+.op-table__head {
+  display: flex; justify-content: space-between; align-items: baseline; gap: 10px;
+  margin: 0 0 10px;
+  color: #e8f0ea; font-size: 14px; text-transform: uppercase; letter-spacing: .08em;
+}
+.op-table__head small { color: #bfe3ee; font-size: 12px; text-transform: none; letter-spacing: 0; }
+.op-table__tip { margin: 10px 0 0; color: #cfe9f1; font-size: 12px; line-height: 1.4; }
+
+.op-tray {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 10px;
+}
+.tray-slot { display: flex; flex-direction: column; align-items: stretch; gap: 5px; min-width: 0; }
+.tray-slot__place {
+  position: relative;
+  aspect-ratio: 8 / 5;
+  border: 2px dashed rgba(220, 240, 246, .45);
+  background: rgba(10, 30, 38, .35);
+}
+.tray-slot__ghost {
+  position: absolute; inset: 10%;
+  width: 80%; height: 80%;
+  opacity: 0; filter: grayscale(1) brightness(2);
+  transition: opacity .15s;
+  pointer-events: none;
+}
+.tray-slot.is-lifted .tray-slot__ghost,
+.tray-slot.is-used .tray-slot__ghost { opacity: .18; }
+.tray-slot.is-used .tray-slot__ghost { inset: 4% 12% 28%; width: 76%; height: 68%; }
+.tray-slot__num {
+  position: absolute; top: 2px; left: 4px;
+  color: rgba(220, 240, 246, .55); font-size: 10px; pointer-events: none;
+}
+.tray-slot__label {
+  min-height: 2.5em;
+  padding: 3px 4px;
+  border: 2px solid #050b0d;
+  background: #f1ead6;
+  color: #1a2a2c;
+  font-size: 12px; line-height: 1.15; text-align: center;
+  box-shadow: 2px 2px 0 rgba(0, 0, 0, .55);
+  overflow-wrap: anywhere;
+}
+
+.tool {
+  position: absolute; inset: 0;
+  display: grid; place-items: center;
+  width: 100%; height: 100%;
+  margin: 0; padding: 6%;
+  border: 0; background: none;
+  cursor: grab;
+  touch-action: none;
+  user-select: none; -webkit-user-select: none;
+  -webkit-tap-highlight-color: transparent;
+  z-index: 2;
+  transition: transform .14s;
+}
+.tool .tool-svg { width: 100%; height: 100%; filter: drop-shadow(3px 3px 0 rgba(0,0,0,.55)); pointer-events: none; }
+.tool:hover:not(:disabled) { transform: translateY(-3px); }
+.tool:focus-visible { outline: 3px solid #f0a95c; outline-offset: -3px; }
+.tool.is-grabbed { cursor: grabbing; z-index: 60; transition: none; }
+.tool.is-grabbed .tool-svg { filter: drop-shadow(8px 10px 0 rgba(0,0,0,.45)); }
+.tool.is-returning { z-index: 50; transition: transform .38s cubic-bezier(.3, 1.4, .5, 1); }
+.tool.is-rejected .tool-svg { animation: op-shake .35s steps(4) .3s; }
+.tool.is-applied { z-index: 60; transition: transform .45s ease-in, opacity .45s ease-in; opacity: 0; pointer-events: none; }
+.tool:disabled { visibility: hidden; }
+
+.tray-slot.is-used .tray-slot__place { border-style: solid; border-color: rgba(127, 214, 176, .7); background: rgba(13, 38, 32, .55); }
+.tray-slot.is-used .tray-slot__place::after {
+  content: '✓ использован';
+  position: absolute; inset: auto 0 4px 0;
+  color: #7fd6b0; font-size: 11px; text-align: center;
+}
+.tray-slot.is-used .tray-slot__label { background: #b9d8c8; color: #355447; text-decoration: line-through; }
+.tray-slot.is-hint .tray-slot__place { border-color: #f0a95c; border-style: solid; animation: op-hint 0.8s steps(2) infinite; }
+@keyframes op-hint { 50% { background: rgba(240, 169, 92, .35); } }
+@keyframes op-shake { 25% { translate: -4px 0; } 50% { translate: 4px 0; } 75% { translate: -3px 0; } }
+
+body.is-dragging-tool, body.is-dragging-tool * { cursor: grabbing !important; }
+
+@media (max-width: 980px) {
+  .op-tray { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 7px; }
+  .tray-slot__label { font-size: 11px; }
+}
+@media (max-width: 760px) {
+  /* На телефоне пациент стоит прямо над столом — тянуть предмет без скролла */
+  .op-board--dnd { grid-template-columns: 1fr; gap: 10px; padding: 16px 14px; min-height: 0; }
+  .op-board--dnd .op-patient,
+  .op-board--dnd .op-work { display: contents; }
+  .op-board--dnd .op-step { order: 1; }
+  .op-board--dnd .op-work h2 { order: 2; margin: 0; font-size: 24px; }
+  .op-board--dnd #op-description { order: 3; }
+  .op-board--dnd .op-feedback { order: 4; margin: 0 !important; min-height: 0; }
+  .op-board--dnd .op-patient__label { order: 5; }
+  .op-board--dnd .op-dropzone { order: 6; }
+  .op-board--dnd .op-table { order: 7; margin-top: 0; }
+  .op-board--dnd .op-vitals { order: 8; }
+  .op-board--dnd .op-patient__note { order: 9; min-height: 0; }
+  .op-board--dnd .op-checklist { order: 10; }
+  .patient-svg { max-height: 250px; margin: 0 auto; }
+  .op-dropzone__hint { font-size: 11px; padding: 3px 6px; }
+  .op-table__tip { display: none; }
+}
+@media (max-width: 480px) {
+  .op-tray { gap: 5px; }
+  .op-table { padding: 8px; }
+  .op-table__head { font-size: 12px; }
+  .op-table__head small { display: none; }
+  .tray-slot__label { font-size: 10px; min-height: 3.4em; padding: 2px; }
+  .tray-slot__num { display: none; }
+  .tray-slot.is-used .tray-slot__place::after { content: '✓'; font-size: 14px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .patient-target, .op-vitals__heart, .op-vitals__ecg polyline, .tray-slot.is-hint .tray-slot__place { animation: none; }
+}
